{
  "name": "iqc-quality-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check": "node --check assets/dashboard.js && node scripts/check.mjs",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.mjs",
    "build:auth": "node scripts/build-auth.mjs",
    "setup:reminders": "node scripts/provision-reminders.mjs",
    "build:reminders": "wrangler deploy --config wrangler.reminders.jsonc --dry-run",
    "start:auth": "node scripts/serve-auth.mjs",
    "start": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.153.0"
  }
}
